# Leave GOOGLE_CLIENT_ID empty to run in demo mode (no Google needed).
PORT=3000
# Timezone used for working hours and the week grid, e.g. Asia/Kolkata
TZ=Asia/Kolkata
WORK_START=9
WORK_END=18
# How many days ahead the rerouter may look for a free slot
SEARCH_DAYS=3

# --- Optional AI (OpenRouter by default; any OpenAI-compatible endpoint works). Empty = rules-only mode, shown as such in the UI ---
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order. Free OpenRouter models shown; they are rate-limited at times, so the list gives fallbacks.
AI_MODEL=nvidia/nemotron-3.5-super-vl:free,recursive/flint-v1.0:free,baidu/ernie-5.5-flash-preview:free

# --- Google (add these yourself; never paste them in chat) ---
# Google Cloud Console > APIs & Services > enable "Google Calendar API"
# OAuth client type: Web application
# Authorized redirect URI: http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Any long random string, used to sign the session cookie
SESSION_SECRET=

# Demo-only: add a fake all-day "Company holiday" to the demo calendar (visual check of all-day handling)
# DEMO_ALLDAY=1
